/* Add near the top if it is not already included. */
#include <input/processors.dtsi>

/* Requires an existing layer constant such as:
 * #define MOUSE 4
 */

/ {
    zip_threshold_layer: zip_threshold_layer {
        compatible = "zmk,input-processor-threshold-layer";
        #input-processor-cells = <2>;
        threshold = <16>;
        reset-timeout-ms = <200>;
    };
};

/* Replace the existing base input-processors section of &trackball_listener. */
&trackball_listener {
    input-processors = <
        &zip_threshold_layer MOUSE 1200
        &zip_xy_scaler 1 1
    >;
};
