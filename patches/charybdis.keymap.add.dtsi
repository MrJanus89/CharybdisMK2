/* Add once near the include section. */
#include <input/processors.dtsi>

/* Keep your existing layer numbers. Example:
 * #define MOUSE 4
 */

/ {
    zip_threshold_layer: zip_threshold_layer {
        compatible = "zmk,input-processor-threshold-layer";
        #input-processor-cells = <2>;
        threshold = <16>;
        reset-timeout-ms = <200>;
    };
};

/* Replace only the base input-processors property in your existing listener. */
&trackball_listener {
    input-processors = <
        &zip_threshold_layer MOUSE 1200
        &zip_xy_scaler 1 1
    >;
};
