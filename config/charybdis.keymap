#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#define BASE 0
#define DIR 1
#define NUM 2
#define FUN 3
#define MOUSE 4
#define SNIPE 5
#define FAST 6
#define NOMODE 7


/ {
    mouse_off: mouse_off {
        compatible = "zmk,behavior-mouse-layer-off";
        #binding-cells = <0>;
        layer = <MOUSE>;
    };

    zip_threshold_layer: zip_threshold_layer {
        compatible = "zmk,input-processor-threshold-layer";
        #input-processor-cells = <2>;
        track-remainders;

        /* Minimum accumulated pointer movement before activation. */
        threshold = <300>;

        /* Trackball movement must continue for this duration. */
        activation-delay-ms = <0>;

        /* A longer event gap resets the continuous-movement timer. */
        movement-gap-ms = <150>;
    };
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&trackball_listener {
    input-processors = <
        &zip_xy_scaler 1 1
		&zip_threshold_layer MOUSE 5000
    >;

    /* Hold DIR: convert trackball movement to vertical/horizontal scrolling. */
    scroll_mode {
        layers = <DIR>;
        input-processors = <
            &zip_xy_scaler 1 18
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    /* Auto-enabled MOUSE layer: normal speed, approximately the configured 800 CPI. */
    mouse_mode {
        layers = <MOUSE>;
        input-processors = <
            &zip_xy_scaler 1 2
            /* Keep refreshing the inactivity timeout after MOUSE activates. */
            &zip_threshold_layer MOUSE 5000
        >;
    };

    /* Hold SNIPE from the MOUSE layer: half-speed, approximately 400 CPI. */
    snipe_mode {
        layers = <SNIPE>;
        input-processors = <
            &zip_xy_scaler 1 5
            /* SNIPE movement also keeps the auto MOUSE layer alive. */
            &zip_threshold_layer MOUSE 5000
        >;
    };

    /* Hold FAST from the MOUSE layer: double-speed, approximately 1600 CPI. */
    fast_mode {
        layers = <FAST>;
        input-processors = <
            &zip_xy_scaler 1 1
            /* FAST movement also keeps the auto MOUSE layer alive. */
            &zip_threshold_layer MOUSE 5000
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_LBRK {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <8 9>;
            bindings = <&kp LBKT>;
            layers = <BASE>;
        };

        combo_RBRK {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <9 10>;
            bindings = <&kp RBKT>;
            layers = <BASE>;
        };

        combo_Tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <25 26>;
            bindings = <&kp TAB>;
            layers = <BASE>;
        };
		
        combo_cut {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <19 20>;
            bindings = <&kp LC(X)>;
            layers = <BASE>;
		};
		
        combo_copy {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <31 32>;
            bindings = <&kp LC(C)>;
            layers = <BASE>;
        };

        combo_paste {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <43 44>;
            bindings = <&kp LC(V)>;
            layers = <BASE>;
		};
		
        combo_undo {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <27 28>;
            bindings = <&kp LC(Z)>;
            layers = <BASE>;
		};
        
		combo_redo {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <15 16>;
            bindings = <&kp LC(Y)>;
            layers = <BASE>;
        };
    };

	behaviors {
        AS: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

		HRM_L: homerow_left {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			bindings = <&kp>, <&kp>;

			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			hold-trigger-on-release;
		};

		HRM_R: homerow_right {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			bindings = <&kp>, <&kp>;

			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			hold-trigger-on-release;
		};

		TD_RAlt_RCTRL: td_ralt_rctrl {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			bindings = <&kp RALT>, <&kp RCTRL>;
			tapping-term-ms = <180>;
		};

        TD_Right: td_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp END>;
            tapping-term-ms = <180>;
        };

        TD_Left: td_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;
            tapping-term-ms = <180>;
        };

        TD_Up: td_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PAGE_UP>;
            tapping-term-ms = <180>;
        };

        TD_Down: td_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PAGE_DOWN>;
            tapping-term-ms = <180>;
        };

        TD_Win: td_win {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&kp RIGHT_WIN>;
            tapping-term-ms = <180>;
        };

        TD_Shift_Caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
            tapping-term-ms = <180>;
        };

        TD_Del_Ins: td_del_ins {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DEL>, <&kp INS>;
            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &AS TILDE GRAVE	&AS EXCLAMATION NUMBER_1  	&AS AT_SIGN NUMBER_2  &AS HASH NUMBER_3 &AS DOLLAR NUMBER_4  	&AS PERCENT N5	&AS CARET NUMBER_6  &AS AMPERSAND NUMBER_7	&AS ASTERISK N8  		&AS LEFT_PARENTHESIS N9 &AS RIGHT_PARENTHESIS N0  	&AS UNDERSCORE MINUS
                &trans		&kp Q  						&kp W  				  &kp E  			&kp R  					&kp T			&kp Y  				&kp U  					&kp I  					&kp O  					&kp P  						&AS PIPE BACKSLASH
                &trans  	&HRM_L LWIN A				&HRM_L LSHIFT S		  &HRM_L LCTRL  D 	&HRM_L LALT   F			&kp G           &kp H  				&HRM_L LALT   J			&HRM_R LCTRL  K			&HRM_R LSHIFT L  		&AS COLON SEMICOLON  		&AS DOUBLE_QUOTES SQT
                &trans		&kp Z  						&kp X  				  &kp C  			&kp V  					&kp B           &kp N  				&kp M  					&AS LESS_THAN COMMA  	&AS GREATER_THAN PERIOD	&AS QUESTION SLASH  		&kp CAPS
																				  &TD_RAlt_RCTRL  	&kp SPACE		  		&TD_Del_Ins		&kp BACKSPACE		&AS LS(ENTER) ENTER  
																									&mo DIR					&mo NUM		  	&mo FUN
            >;
        };

        dir_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&trans 		&trans		  &trans		&trans
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&TD_Up 		&trans 		  &trans		&trans
                &trans &trans &trans &trans &trans &trans    &trans  &TD_Left 		&TD_Down 	&TD_Right	  &trans		&trans
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&trans 		&trans 		  &trans		&trans
									 &trans &trans &trans 	 &kp ESC &trans			
											&trans &trans 	 &trans
            >;
        };

        num_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans 					&kp PRINTSCREEN			 	&kp SCROLLLOCK				&kp PAUSE_BREAK			&trans 					&trans
                &trans &trans &trans &trans &trans &trans    &kp SLASH 					&AS AMPERSAND NUMBER_7 	 	&AS ASTERISK NUMBER_8		&AS LEFT_PARENTHESIS N9 &AS UNDERSCORE MINUS	&trans
                &trans &trans &trans &trans &trans &trans    &kp ASTERISK 				&AS DOLLAR NUMBER_4 	 	&AS PERCENT N5 				&AS CARET NUMBER_6		&AS EQUAL PLUS 			&trans
                &trans &trans &trans &trans &trans &trans    &AS RIGHT_PARENTHESIS N0	&AS EXCLAMATION NUMBER_1	&AS AT_SIGN NUMBER_2 		&AS HASH NUMBER_3		&AS TILDE GRAVE			&trans
									 &trans &trans &trans	 &kp ESC		&trans 
											&trans &trans	 &trans
            >;
        };

        fun_layer {
            bindings = <
                &bt BT_SEL 0 	&trans &kp F10 &kp F11 	&kp F12 &trans   &trans &trans &trans &trans &trans	&bt BT_CLR
                &bt BT_SEL 1	&trans &kp F7	&kp F8	&kp F9 	&trans   &trans &trans &trans &trans &trans &trans
                &bt BT_SEL 2	&trans &kp F4	&kp F5	&kp F6 	&trans   &trans &trans &trans &trans &trans	&trans
                &bt BT_SEL 3	&trans &kp F1	&kp F2 	&kp F3 	&trans   &trans &trans &trans &trans &trans &bt BT_DISC
										  &trans &trans &kp ESC	 &trans		&trans 
												 &trans &trans	 &trans
            >;
        };

        mouse_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                                        &trans		&mouse_off 	&trans	 	&trans &trans 
													&mo SNIPE	&mo FAST 	&trans
            >;
        };

        snipe_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
										&trans 		&trans 	 	&trans 		&trans &trans 
													&trans 	 	&trans	 	&trans
            >;
        };

        fast_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans &trans &trans &trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans &trans &trans &trans
										&trans 		&trans 	 	&trans 		&trans &trans 
													&trans 	 	&trans	 	&trans
            >;
        };

        nomode_layer {
            bindings = <
                &AS TILDE GRAVE	&AS EXCLAMATION NUMBER_1  	&AS AT_SIGN NUMBER_2  &AS HASH NUMBER_3 &AS DOLLAR NUMBER_4  	&AS PERCENT N5	&AS CARET NUMBER_6  &AS AMPERSAND NUMBER_7	&AS ASTERISK N8  		&AS LEFT_PARENTHESIS N9 &AS RIGHT_PARENTHESIS N0  	&AS UNDERSCORE MINUS
                &tog DIR		&kp Q  						&kp W  				  &kp E  			&kp R  					&kp T			&kp Y  				&kp U  					&kp I  					&kp O  					&kp P  						&AS PIPE BACKSLASH
                &tog NUM  		&kp A						&kp S		  		  &kp D 			&kp F					&kp G           &kp H  				&kp J					&kp  K					&kp L  					&AS COLON SEMICOLON  		&AS DOUBLE_QUOTES SQT
                &tog NOMODE		&kp Z  						&kp X  				  &kp C  			&kp V  					&kp B           &kp N  				&kp M  					&AS LESS_THAN COMMA  	&AS GREATER_THAN PERIOD	&AS QUESTION SLASH  		&kp CAPS
																				  &TD_RAlt_RCTRL  	&lt 3 SPACE		  		&mo DIR  		&mo FUN				&AS LS(ENTER) ENTER  
																									&mo FUN					&TD_Del_Ins  	&kp BACKSPACE
            >;
        };
    };
};
