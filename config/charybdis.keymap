#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#define BASE 0
#define DIR 1
#define NUM 2
#define FUN 3
#define MOUSE 4
#define SNIPE 5
#define FAST 6

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&trackball_listener {
    /* Any normal pointer movement enables the mouse-button layer for 1 second. */
    input-processors = <
        &zip_temp_layer MOUSE 1000
        &zip_xy_scaler 1 1
    >;

    /* Hold DIR: convert trackball movement to vertical/horizontal scrolling. */
    scroll_mode {
        layers = <DIR>;
        input-processors = <
            &zip_xy_scaler 1 12
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    /* Auto-enabled MOUSE layer: normal speed, approximately the configured 800 CPI. */
    mouse_mode {
        layers = <MOUSE>;
        input-processors = <
            &zip_xy_scaler 1 2
        >;
    };

    /* Hold SNIPE from the MOUSE layer: half-speed, approximately 400 CPI. */
    snipe_mode {
        layers = <SNIPE>;
        input-processors = <
            &zip_xy_scaler 1 5
        >;
    };

    /* Hold FAST from the MOUSE layer: double-speed, approximately 1600 CPI. */
    fast_mode {
        layers = <FAST>;
        input-processors = <
            &zip_xy_scaler 1 1
        >;
    };
};

/ {
    behaviors {
        AS: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        TD_Alt: td_alt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp RIGHT_ALT>;
            tapping-term-ms = <180>;
        };

        TD_Right: td_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp END>;
            tapping-term-ms = <180>;
        };

        TD_Left: td_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;
            tapping-term-ms = <180>;
        };

        TD_Up: td_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PAGE_UP>;
            tapping-term-ms = <180>;
        };

        TD_Down: td_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PAGE_DOWN>;
            tapping-term-ms = <180>;
        };

        TD_Win: td_win {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&kp RIGHT_WIN>;
            tapping-term-ms = <180>;
        };

        TD_Shift_Caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
            tapping-term-ms = <180>;
        };

        TD_Del_Ins: td_del_ins {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DEL>, <&kp INS>;
            tapping-term-ms = <180>;
        };

        TD_MB2_MB3: td_mb2_mb3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mkp MB2>, <&mkp MB3>;
            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &AS TILDE GRAVE	&AS EXCLAMATION NUMBER_1  	&AS AT_SIGN NUMBER_2  &AS HASH NUMBER_3 &AS DOLLAR NUMBER_4  	&AS PERCENT N5	&AS CARET NUMBER_6  &AS AMPERSAND NUMBER_7	&AS ASTERISK N8  		&AS LEFT_PARENTHESIS N9 &AS RIGHT_PARENTHESIS N0  	&AS UNDERSCORE MINUS
                &kp TAB  		&kp Q  						&kp W  				  &kp E  			&kp R  					&kp T			&kp Y  				&kp U  					&kp I  					&kp O  					&kp P  						&AS PIPE BACKSLASH
                &TD_Win  		&kp A  						&AS LEFT_SHIFT S  	  &AS LCTRL D  		&AS LEFT_ALT F  		&kp G           &kp H  				&AS RIGHT_ALT J  		&AS RCTRL K  			&AS RIGHT_SHIFT L  		&AS COLON SEMICOLON  	&AS DOUBLE_QUOTES SQT
                &TD_Shift_Caps	&kp Z  						&kp X  				  &kp C  			&kp V  					&kp B           &kp N  &kp M  		&AS LESS_THAN COMMA  	&AS GREATER_THAN PERIOD	&AS QUESTION SLASH  	&TD_MB2_MB3
																				  &kp LCTRL		  	&kp SPACE		  		&mo DIR  		&mo NUM				&AS LS(KP_ENTER) KP_ENTER  
																									&kp LALT				&TD_Del_Ins  	&lt FUN BACKSPACE
            >;
        };

        dir_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&trans 		&AS LBRC LBKT &AS RBRC RBKT &AS PLUS EQUAL
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&TD_Up 		&trans 		  &trans		&trans
                &trans &trans &trans &trans &trans &trans    &trans  &TD_Left 		&TD_Down 	&TD_Right	  &trans		&trans
                &trans &trans &trans &trans &trans &trans    &trans  &trans 		&trans 		&trans 		  &trans		&trans
									 &trans &trans &trans 	 &kp ESC &trans			
											&trans &trans 	 &trans
            >;
        };

        num_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans 					&kp PRINTSCREEN			 	&kp SCROLLLOCK				&kp PAUSE_BREAK			&trans 		&trans
                &trans &trans &trans &trans &trans &trans    &kp SLASH 					&AS AMPERSAND NUMBER_7 	 	&AS ASTERISK NUMBER_8		&AS LEFT_PARENTHESIS N9 &kp MINUS	&trans
                &trans &trans &trans &trans &trans &trans    &kp ASTERISK 				&AS DOLLAR NUMBER_4 	 	&AS PERCENT N5 				&AS CARET NUMBER_6		&kp PLUS	&trans
                &trans &trans &trans &trans &trans &trans    &AS RIGHT_PARENTHESIS N0	&AS EXCLAMATION NUMBER_1	&AS AT_SIGN NUMBER_2 		&AS HASH NUMBER_3		&kp EQUAL	&trans
									 &trans &trans &trans	 &kp ESC		&trans 
											&trans &trans	 &trans
            >;
        };

        fun_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans 	&kp F10 &kp F11 &kp F12 &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans 	&kp F7	&kp F8	&kp F9 	&trans &trans
                &trans &trans &trans &trans &trans &trans   &trans 	&kp F4	&kp F5	&kp F6 	&trans &trans
                &trans &trans &trans &trans &trans &trans   &trans 	&kp F1	&kp F2 	&kp F3 	&trans &trans
									 &trans &trans &trans	&kp ESC	&trans 
											&trans &trans	&trans
            >;
        };

        mouse_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans 	&trans 		&trans 		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2	&trans
										&mo SNIPE	&mo FAST 	&trans	 	&trans &trans 
													&trans 		&trans	  	
            >;
        };

        snipe_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans 	&trans 		&trans 		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2	&trans
										&trans 		&trans 	 	&trans 		&trans &trans 
													&trans 	 	&trans	 	&trans
            >;
        };

        fast_layer {
            bindings = <
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &trans 	&trans 		&trans		&trans
                &trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2 	&trans  	&trans &trans &trans 	&trans 		&trans 		&trans
                &trans &trans &trans 	&trans 		&trans 	 	&trans   	&trans &trans &mkp MB1 	&mkp MB3 	&mkp MB2	&trans
										&trans 		&trans 	 	&trans 		&trans &trans 
													&trans 	 	&trans	 	&trans
            >;
        };
    };
};
