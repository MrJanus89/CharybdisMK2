#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
    AS: auto_shift {
        compatible = "zmk,behavior-hold-tap";
        label = "AS";
        #binding-cells = <2>;
        bindings = <&kp>, <&kp>;

        tapping-term-ms = <200>;
        quick-tap-ms = <0>;
        flavor = "tap-preferred";
    };
};

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&AS TILDE GRAVE  &AS EXCLAMATION NUMBER_1  &AS AT_SIGN NUMBER_2  &AS HASH NUMBER_3  &AS DOLLAR NUMBER_4  &AS PERCENT N5    &AS CARET NUMBER_6         &AS AMPERSAND NUMBER_7  &AS ASTERISK N8      &AS LEFT_PARENTHESIS N9  &AS RIGHT_PARENTHESIS N0  &AS UNDERSCORE MINUS
&kp LCTRL        &AS LS(Q) Q               &AS LS(W) W           &AS LS(E) E        &AS LS(R) R          &AS LS(T) T       &AS LS(Y) Y                &AS LS(U) U             &AS LS(I) I          &AS LS(O) O              &AS LS(P) P               &AS PIPE BACKSLASH
&kp LEFT_ALT     &AS LS(A) A               &AS LS(S) S           &AS LS(D) D        &AS LS(F) F          &AS LS(G) G       &AS LS(H) H                &AS LS(J) J             &AS LS(K) K          &AS LS(L) L              &AS SEMI COLON            &AS DOUBLE_QUOTES SQT
&kp LEFT_SHIFT   &AS LS(Z) Z               &AS LS(X) X           &AS LS(C) C        &AS LS(V) V          &AS LS(B) B       &AS LS(N) N                &AS LS(M) M             &AS LESS_THAN COMMA  &AS GREATER_THAN PERIOD  &AS QUESTION SLASH        &AS RGUI LGUI
                                                                 &mkp MB1           &kp DEL              &mo 1             &mo 2                      &kp BACKSPACE
                                                                                    &mkp MB2             &kp SPACE         &kp KP_ENTER
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_1 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7   &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &kp UP    &trans     &trans   &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp RIGHT_ALT
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans    &trans     &trans   &kp RIGHT_SHIFT
                        &trans  &trans  &trans    &kp ESC  &trans
                                &trans  &trans    &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_2 {
            bindings = <
&kp TAB  &trans  &trans  &trans  &trans  &trans     &kp SLASH  &trans     &trans    &AS LS(LEFT_BRACKET) LEFT_BRACKET  &AS LS(RBKT) RBKT  &AS PLUS EQUAL
&trans   &trans  &trans  &trans  &trans  &trans     &kp ASTERISK  &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK                    &trans             &kp RCTRL
&trans   &trans  &trans  &trans  &trans  &trans     &kp MINUS  &kp INS    &kp HOME  &kp PG_UP                          &trans             &kp RIGHT_ALT
&trans   &trans  &trans  &trans  &trans  &trans     &kp PLUS   &kp DEL    &kp END   &kp PG_DN                          &trans             &kp RIGHT_SHIFT
                         &trans  &trans  &kp ESC    &trans     &trans
                                 &trans  &trans     &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
          trackball-bindings = <&tsl>;
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
                trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;
                
        };*/
    };
};
