#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        AS: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        TD_Alt: TD_Alt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp RIGHT_ALT>;
        };

        TD_Right: TD_Right {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp END>;

            tapping-term-ms = <180>;
        };

        TD_Left: TD_Left {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;

            tapping-term-ms = <180>;
        };

        TD_Up: TD_Up {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_UP";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PAGE_UP>;

            tapping-term-ms = <180>;
        };

        TD_Down: TD_Down {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOWN";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PAGE_DOWN>;

            tapping-term-ms = <180>;
        };

        TD_Win: TD_Win {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_WIN";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&kp RIGHT_WIN>;

            tapping-term-ms = <180>;
        };

        TD_Shift_Caps: TD_Shift_Caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;

            tapping-term-ms = <180>;
        };

        TD_Del_Ins: TD_Del_Ins {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DEL_INS";
            #binding-cells = <0>;
            bindings = <&kp DEL>, <&kp INS>;

            tapping-term-ms = <180>;
        };

        TD_MB2_MB3: TD_MB2_MB3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MB2_MB3";
            #binding-cells = <0>;
            bindings = <&mkp MB2>, <&mkp MB3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&AS TILDE GRAVE  &AS EXCLAMATION NUMBER_1  &AS AT_SIGN NUMBER_2  &AS HASH NUMBER_3  &AS DOLLAR NUMBER_4  &AS PERCENT N5    &AS CARET NUMBER_6  &AS AMPERSAND NUMBER_7     &AS ASTERISK N8      &AS LEFT_PARENTHESIS N9  &AS RIGHT_PARENTHESIS N0  &AS UNDERSCORE MINUS
&kp TAB          &kp Q                     &kp W                 &kp E              &kp R                &kp T             &kp Y               &kp U                      &kp I                &kp O                    &kp P                     &AS PIPE BACKSLASH
&TD_Win          &kp A                     &AS LEFT_SHIFT S      &AS LCTRL D        &AS LEFT_ALT F       &kp G             &kp H               &AS RIGHT_ALT J            &AS RCTRL K          &AS RIGHT_SHIFT L        &AS COLON SEMICOLON       &AS DOUBLE_QUOTES SQT
&mkp MB1         &kp Z                     &kp X                 &kp C              &kp V                &kp B             &kp N               &kp M                      &AS LESS_THAN COMMA  &AS GREATER_THAN PERIOD  &AS QUESTION SLASH        &TD_MB2_MB3
                                                                 &TD_Shift_Caps     &AS LCTRL SPACE      &mo 1             &mo 2               &AS LS(KP_ENTER) KP_ENTER
                                                                                    &TD_Alt              &TD_Del_Ins       &lt 3 BACKSPACE
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        Directional {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans    &AS LBRC LBKT  &AS RBRC RBKT  &AS PLUS EQUAL
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &TD_Up    &trans         &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &TD_Left  &TD_Down  &TD_Right      &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans    &trans         &trans         &trans
                        &trans  &trans  &trans    &kp ESC  &trans
                                &trans  &trans    &trans
            >;

            trackball-bindings = <&tmv_fine>;
        };

        NumPad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans                    &kp PRINTSCREEN           &kp SCROLLLOCK         &kp PAUSE_BREAK          &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans     &kp SLASH                 &AS AMPERSAND NUMBER_7    &AS ASTERISK NUMBER_8  &AS LEFT_PARENTHESIS N9  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &kp ASTERISK              &AS DOLLAR NUMBER_4       &AS PERCENT N5         &AS CARET NUMBER_6       &kp PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans     &AS RIGHT_PARENTHESIS N0  &AS EXCLAMATION NUMBER_1  &AS AT_SIGN NUMBER_2   &AS HASH NUMBER_3        &kp EQUAL  &trans
                        &trans  &trans  &kp ESC    &trans                    &trans
                                &trans  &trans     &trans
            >;

            trackball-bindings = <&tmv_fine>;
        };

        Function {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F10  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F4   &kp F5   &kp F6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
                        &trans  &trans  &kp ESC    &trans  &trans
                                &trans  &trans     &trans
            >;

            trackball-bindings = <&tmv_fine>;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
				trackball-bindings = <&tmv_fine>;           
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;
				trackball-bindings = <&tmv_fine>;            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;                               
				trackball-bindings = <&tmv_fine>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;                
        };*/
    };
};
