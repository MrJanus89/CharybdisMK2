#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>

#define BASE 0
#define MOUSE 1

/ {
    zip_threshold_layer: zip_threshold_layer {
        compatible = "zmk,input-processor-threshold-layer";
        #input-processor-cells = <2>;
        threshold = <16>;
        reset-timeout-ms = <200>;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
                &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T
                &kp Y      &kp U      &kp I      &kp O      &kp P      &kp RET
                &kp LSHFT  &kp A      &kp S      &kp D      &kp F      &kp G
                &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &kp B
                &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
                           &kp LALT   &kp SPACE  &mo MOUSE
                &kp RALT   &kp SPACE  &kp DEL    &kp BSPC   &kp ENTER
            >;
        };

        mouse_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                       &trans &trans &mkp LCLK
                &mkp RCLK &trans &trans &trans &trans
            >;
        };
    };
};

&trackball_listener {
    input-processors = <
        &zip_threshold_layer MOUSE 1200
        &zip_xy_scaler 1 1
    >;
};
