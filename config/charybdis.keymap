#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        AS: AS {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&AS GRAVE TILDE  &AS N1 EXCL  &AS N2 AT  &AS N3 HASH  &AS N4 DLLR  &AS N5 PERCENT    &AS N6 CARET         &AS N7 AMPS    &AS N8 ASTRK  &AS N9 LPAR  &AS N0 RPAR  &AS MINUS UNDER
&kp LCTRL        &kp Q        &kp W      &kp E        &kp R        &kp T             &kp Y                &kp U          &kp I         &kp O        &kp P        &kp BSLH
&kp LEFT_ALT     &kp A        &kp S      &kp D        &kp F        &kp G             &kp H                &kp J          &kp K         &kp L        &kp SEMI     &kp SQT
&kp LEFT_SHIFT   &kp Z        &kp X      &kp C        &kp V        &kp B             &kp N                &kp M          &kp COMMA     &kp PERIOD   &kp FSLH     &AS LEFT_GUI RIGHT_GUI
                                         &mkp MB1     &kp DEL      &mo 1             &mo 2                &kp BACKSPACE
                                                      &mkp MB2     &kp SPACE         &AS KP_ENTER RETURN
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_1 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7   &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &kp UP    &trans     &trans   &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp RIGHT_ALT
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans    &trans     &trans   &kp RIGHT_SHIFT
                        &trans  &trans  &trans    &kp ESC  &trans
                                &trans  &trans    &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_2 {
            bindings = <
&kp TAB  &trans  &trans  &trans  &trans  &trans        &kp SLASH  &trans  &trans     &AS LEFT_BRACKET LEFT_BRACE  &AS RIGHT_BRACKET RIGHT_BRACE  &AS EQUAL PLUS
&trans   &trans  &trans  &trans  &trans  &trans        &kp ASTRK  &trans  &kp PSCRN  &kp SCROLLLOCK               &kp PAUSE_BREAK                &kp RCTRL
&trans   &trans  &trans  &trans  &trans  &trans        &kp MINUS  &trans  &kp INS    &kp HOME                     &kp PG_UP                      &kp RIGHT_ALT
&trans   &trans  &trans  &trans  &trans  &trans        &kp PLUS   &trans  &kp DEL    &kp END                      &kp PG_DN                      &kp RIGHT_SHIFT
                         &trans  &trans  &kp ESCAPE    &trans     &trans
                                 &trans  &trans        &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
          trackball-bindings = <&tsl>;
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
                trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;
                
        };*/
    };
};
